# Copia este archivo como .env y configura tus valores locales.
# No compartas ni subas .env; el backend lo carga al iniciar.
STORAGE=mongo
# MongoDB local para desarrollo; reemplázalo por el URI de Atlas si aplica.
MONGO_URI=mongodb://localhost:27017
MONGO_DB=RentControl
MONGO_COLLECTION=practica15_persistencia
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
# Establecer antes de exponer la API fuera de un entorno de demostración local.
RENTCONTROL_API_KEY=
